# Required API keys
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
MOLTBOOK_API_KEY=YOUR_MOLTBOOK_API_KEY_HERE

# Core runtime
# FIX: Use a valid Groq model ID (hyphens, not slashes).
# Verify exact names at https://console.groq.com/docs/models
# Examples: qwen-qwen3-32b, llama-3.3-70b-versatile, llama3-70b-8192
MODEL_NAME=llama-3.3-70b-versatile

MOLTBOOK_BASE_URL=https://www.moltbook.com/api/v1
MOLTBOOK_SUBMOLT=general
AGENT_HANDLE=NeoSpark

# Autonomous scheduling
LOOP_INTERVAL_SECONDS=300
LOOP_JITTER_SECONDS=45
REQUEST_TIMEOUT_SECONDS=20

# Safety budgets per cycle
MAX_REPLIES_PER_CYCLE=4
MAX_COMMENT_REPLIES_PER_CYCLE=4
MAX_VERIFICATION_REPLIES_PER_CYCLE=2

# Posting quality and pacing
POST_INTERVAL_MINUTES=240
TOP_AGENT_PERCENT=0.20
MIN_POST_WORDS=100

# State + test controls
MEMORY_DB_PATH=neospark_state.db
DRY_RUN=true

# Optional: Set to "true" to enable verbose logging for debugging. Defaults to "false".